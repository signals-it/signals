{
  "realm": "signals",
  "enabled": true,
  "displayName": "Signals",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "bruteForceProtected": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "registrationEmailAsUsername": true,
  "identityProviders": [
    {
      "alias": "corporate-xyz",
      "displayName": "CorporateXYZ SSO",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "signals-enterprise",
        "clientSecret": "GENERATE_CORPORATE_SECRET",
        "authorizationUrl": "http://localhost:8080/realms/CorporateXYZ/protocol/openid-connect/auth",
        "tokenUrl": "http://localhost:8080/realms/CorporateXYZ/protocol/openid-connect/token",
        "userInfoUrl": "http://localhost:8080/realms/CorporateXYZ/protocol/openid-connect/userinfo",
        "jwksUrl": "http://localhost:8080/realms/CorporateXYZ/protocol/openid-connect/certs",
        "issuer": "http://localhost:8080/realms/CorporateXYZ",
        "clientAuthMethod": "client_secret_post",
        "syncMode": "IMPORT",
        "useJwksUrl": "true"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "email",
      "identityProviderAlias": "corporate-xyz",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "email",
        "user.attribute": "email"
      }
    },
    {
      "name": "firstName",
      "identityProviderAlias": "corporate-xyz",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "given_name",
        "user.attribute": "firstName"
      }
    },
    {
      "name": "lastName",
      "identityProviderAlias": "corporate-xyz",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "family_name",
        "user.attribute": "lastName"
      }
    }
  ],
  "clients": [
    {
      "clientId": "signals-bff",
      "name": "Signals Node BFF",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "GENERATE_CLIENT_SECRET",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [
        "http://localhost:5173/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173"
      },
      "defaultClientScopes": [
        "web-origins",
        "profile",
        "email",
        "roles",
        "offline_access"
      ]
    }
  ]
}