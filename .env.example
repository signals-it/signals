# Local development only. Generated by npm run setup:local.
NODE_ENV=development

# Proxy API (apps/proxy-api): UI authentication, sessions, token renewal and the
# authenticated proxy. This is the only Node service the SPA talks to.
API_HOST=127.0.0.1
API_PORT=4000
APP_ORIGIN=http://localhost:5173
OIDC_CALLBACK_URL=http://localhost:5173/auth/callback
OIDC_ISSUER=http://localhost:8080/realms/signals
KEYCLOAK_CLIENT_ID=signals-bff
KEYCLOAK_CLIENT_SECRET=GENERATE_CLIENT_SECRET
SESSION_ENCRYPTION_KEY=GENERATE_SESSION_KEY

# Backend API (apps/api): the Signals backend. Internal only; reachable by the
# proxy, never by the browser.
BACKEND_API_HOST=127.0.0.1
BACKEND_API_PORT=4100
BACKEND_INTERNAL_TOKEN=GENERATE_INTERNAL_TOKEN

# Shared platform database. Migrations and the membership CLI run from the
# backend API package.
PLATFORM_DB_NAME=signals
PLATFORM_DB_USER=signals
PLATFORM_DB_PASSWORD=local-signals-db
PLATFORM_DATABASE_URL=postgresql://signals:local-signals-db@localhost:5432/signals

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=local-keycloak-admin
KEYCLOAK_DB_PASSWORD=local-keycloak-db
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=signals
KEYCLOAK_REDIRECT_URI=http://localhost:5173/auth/callback

# Session and CSRF controls (optional; defaults shown)
CSRF_HEADER_NAME=x-csrf-token
SESSION_IDLE_EXPIRY_SECONDS=1800
SESSION_ABSOLUTE_EXPIRY_SECONDS=28800
TOKEN_RENEWAL_THRESHOLD_SECONDS=30

# Proxy -> backend API. The proxy resolves registered operation paths against
# this base URL and forwards with a bearer token plus the internal session
# reference. Only allowlisted paths/methods are proxied.
SIGNALS_BACKEND_BASE_URL=http://127.0.0.1:4100
PROXY_BACKEND_TIMEOUT_MS=30000
PROXY_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE
PROXY_ALLOWED_REQUEST_HEADERS=content-type,x-correlation-id,x-requested-with
PROXY_ALLOWED_RESPONSE_HEADERS=content-type,x-request-id,x-correlation-id,cache-control
PROXY_REGISTRY_PATH=

GLPI_DB_NAME=glpi
GLPI_DB_USER=glpi
GLPI_DB_PASSWORD=local-glpi-db
GLPI_DB_ROOT_PASSWORD=local-glpi-root
GLPI_URL=http://localhost:8081
GLPI_API_TOKEN=
ZABBIX_DB_NAME=zabbix
ZABBIX_DB_USER=zabbix
ZABBIX_DB_PASSWORD=local-zabbix-db
ZABBIX_URL=http://localhost:8082
ZABBIX_API_TOKEN=
